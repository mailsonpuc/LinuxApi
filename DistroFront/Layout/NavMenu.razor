<MudNavMenu Class="pa-3">
    <MudText Typo="Typo.overline" Class="px-3 mb-2 mud-text-secondary">Operacao</MudText>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    <MudNavLink Href="distros" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Memory">Distros</MudNavLink>
    <MudNavLink Href="categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">Categorias</MudNavLink>
    <MudNavLink Href="generate" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AutoAwesome">Gerador IA</MudNavLink>

    <MudDivider Class="my-4" />
    <MudText Typo="Typo.overline" Class="px-3 mb-2 mud-text-secondary">Acesso</MudText>
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="distros/new" Icon="@Icons.Material.Filled.AddCircle">Nova distro</MudNavLink>
            <MudNavLink Href="categories/new" Icon="@Icons.Material.Filled.CreateNewFolder">Nova categoria</MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="login" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
            <MudNavLink Href="register" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonAdd">Registro</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>
