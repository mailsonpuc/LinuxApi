@page "/"
@inject ICategoryService CategoryService
@inject IDistroService DistroService
@inject ISnackbar Snackbar

<PageTitle>Dashboard</PageTitle>

<MudStack Spacing="4">
    <div class="page-header">
        <div>
            <MudBreadcrumbs Items="_breadcrumbs" />
            <MudText Typo="Typo.h4" Class="font-weight-bold">Dashboard</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary">Visao geral do catalogo de distribuicoes Linux.</MudText>
        </div>
        <MudButton Href="distros/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Nova distro</MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <StatCard Label="Distros" Value="@_distros.Count.ToString()" Caption="Registros cadastrados" Icon="@Icons.Material.Filled.Memory" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <StatCard Label="Categorias" Value="@_categories.Count.ToString()" Caption="Agrupamentos ativos" Icon="@Icons.Material.Filled.Category" Color="Color.Secondary" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <StatCard Label="Com ISO" Value="@_distros.Count(d => !string.IsNullOrWhiteSpace(d.Iso)).ToString()" Caption="Downloads mapeados" Icon="@Icons.Material.Filled.Download" Color="Color.Info" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <StatCard Label="Cobertura" Value="@CoverageText" Caption="Distros categorizadas" Icon="@Icons.Material.Filled.Verified" Color="Color.Success" />
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" md="7">
                <MudCard Elevation="0" Class="dashboard-card">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Distribuicoes por categoria</MudText>
                        <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@_chartSeries" ChartLabels="@_chartLabels" Width="100%" Height="320px" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="5">
                <MudCard Elevation="0" Class="dashboard-card">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Ultimos registros</MudText>
                        @if (_distros.Count == 0)
                        {
                            <EmptyState Title="Sem distros" Message="Cadastre a primeira distribuicao." ActionHref="distros/new" ActionText="Nova distro" />
                        }
                        else
                        {
                            <MudList T="DistroDto" Dense="true" Class="mt-3">
                                @foreach (var distro in _distros.TakeLast(5).Reverse())
                                {
                                    <MudListItem Href="@($"distros/{distro.DistroId}")" Icon="@Icons.Material.Filled.ChevronRight">
                                        <MudText>@distro.Nome</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@GetCategoryName(distro.CategoryId)</MudText>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Dashboard", href: null, disabled: true)];
    private IReadOnlyList<CategoryDto> _categories = [];
    private IReadOnlyList<DistroDto> _distros = [];
    private List<ChartSeries<double>> _chartSeries = [];
    private string[] _chartLabels = [];
    private bool _loading = true;

    private string CoverageText => _distros.Count == 0 ? "0%" : $"{_distros.Count(d => d.CategoryId != Guid.Empty) * 100 / _distros.Count}%";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            _categories = await CategoryService.GetAllAsync(cts.Token);
            _distros = await DistroService.GetAllAsync(cts.Token);
            BuildChart();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nao foi possivel carregar o dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildChart()
    {
        var groups = _categories
            .Select(c => new { Label = c.Name ?? "Sem nome", Count = _distros.Count(d => d.CategoryId == c.CategoryId) })
            .Where(item => item.Count > 0)
            .ToList();

        _chartLabels = groups.Count == 0 ? ["Sem dados"] : groups.Select(g => g.Label).ToArray();
        _chartSeries =
        [
            new ChartSeries<double>
            {
                Name = "Distros",
                Data = groups.Count == 0 ? [1] : groups.Select(g => (double)g.Count).ToArray()
            }
        ];
    }

    private string GetCategoryName(Guid categoryId)
    {
        return _categories.FirstOrDefault(c => c.CategoryId == categoryId)?.Name ?? "Sem categoria";
    }
}
