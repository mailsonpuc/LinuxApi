@page "/categories/{Id:guid}"
@inject ICategoryService CategoryService
@inject IDistroService DistroService
@inject ISnackbar Snackbar

<PageTitle>Categoria</PageTitle>

<MudStack Spacing="4">
    <div class="page-header">
        <div>
            <MudBreadcrumbs Items="_breadcrumbs" />
            <MudText Typo="Typo.h4" Class="font-weight-bold">@(_category?.Name ?? "Categoria")</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary">Detalhes e distribuicoes associadas.</MudText>
        </div>
        @if (_category is not null)
        {
            <MudButton Href="@($"categories/{_category.CategoryId}/edit")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Editar</MudButton>
        }
    </div>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_category is null)
    {
        <EmptyState Title="Categoria nao encontrada" Message="O registro solicitado nao foi retornado pela API." ActionHref="categories" ActionText="Voltar" ActionIcon="@Icons.Material.Filled.ArrowBack" />
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="4">
                <StatCard Label="Categoria" Value="@_category.Name" Caption="@_category.CategoryId.ToString()" Icon="@Icons.Material.Filled.Category" Color="Color.Secondary" />
            </MudItem>
            <MudItem xs="12" md="4">
                <StatCard Label="Distros" Value="@_related.Count.ToString()" Caption="Registros vinculados" Icon="@Icons.Material.Filled.Memory" Color="Color.Primary" />
            </MudItem>
        </MudGrid>

        <MudCard Elevation="0" Class="data-card">
            <MudCardContent>
                <MudText Typo="Typo.h6">Distribuicoes nesta categoria</MudText>
                <MudTable Items="@_related" Hover="true" Dense="true" Class="mt-3">
                    <HeaderContent>
                        <MudTh>Nome</MudTh>
                        <MudTh>ISO</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Nome"><MudLink Href="@($"distros/{context.DistroId}")">@context.Nome</MudLink></MudTd>
                        <MudTd DataLabel="ISO">@context.Iso</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <EmptyState Title="Sem distros vinculadas" Message="Nenhuma distribuicao usa esta categoria." />
                    </NoRecordsContent>
                </MudTable>
            </MudCardContent>
        </MudCard>
    }
</MudStack>

@code {
    [Parameter] public Guid Id { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Dashboard", "/"), new("Categorias", "categories"), new("Detalhes", href: null, disabled: true)];
    private CategoryDto? _category;
    private IReadOnlyList<DistroDto> _related = [];
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            _category = await CategoryService.GetByIdAsync(Id, cts.Token);
            var distros = await DistroService.GetAllAsync(cts.Token);
            _related = distros.Where(d => d.CategoryId == Id).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar categoria: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    
}
