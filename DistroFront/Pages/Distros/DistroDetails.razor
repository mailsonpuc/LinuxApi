@page "/distros/{Id:guid}"
@inject IDistroService DistroService
@inject ICategoryService CategoryService
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Options.IOptions<ApiOptions> ApiOptions

<PageTitle>Distro</PageTitle>

<MudStack Spacing="4">
    <div class="page-header">
        <div>
            <MudBreadcrumbs Items="_breadcrumbs" />
            <MudText Typo="Typo.h4" Class="font-weight-bold">@(_distro?.Nome ?? "Distro")</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary">Dados completos do registro.</MudText>
        </div>
        @if (_distro is not null)
        {
            <MudButton Href="@($"distros/{_distro.DistroId}/edit")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Editar</MudButton>
        }
    </div>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_distro is null)
    {
        <EmptyState Title="Distro nao encontrada" Message="O registro solicitado nao foi retornado pela API." ActionHref="distros" ActionText="Voltar" ActionIcon="@Icons.Material.Filled.ArrowBack" />
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudCard Elevation="0" Class="detail-media">
                    <MudCardContent>
                        <MudImage Src="@ResolveImage(_distro.ImageUrl)" Alt="@_distro.Nome" Class="distro-image" ObjectFit="ObjectFit.Cover" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudCard Elevation="0" Class="form-card">
                    <MudCardContent>
                        <MudTabs Rounded="true" Border="true">
                            <MudTabPanel Text="Resumo" Icon="@Icons.Material.Filled.Info">
                                <MudText Typo="Typo.h6">@_distro.Nome</MudText>
                                <MudText Class="mt-3">@_distro.Descricao</MudText>
                            </MudTabPanel>
                            <MudTabPanel Text="Tecnico" Icon="@Icons.Material.Filled.Storage">
                                <MudStack Spacing="2" Class="mt-2">
                                    <MudText><b>ISO:</b> @_distro.Iso</MudText>
                                    <MudText><b>Categoria:</b> @GetCategoryName(_distro.CategoryId)</MudText>
                                    <MudText><b>ID:</b> @_distro.DistroId</MudText>
                                </MudStack>
                            </MudTabPanel>
                        </MudTabs>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    [Parameter] public Guid Id { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Dashboard", "/"), new("Distros", "distros"), new("Detalhes", href: null, disabled: true)];
    private DistroDto? _distro;
    private IReadOnlyList<CategoryDto> _categories = [];
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            _categories = await CategoryService.GetAllAsync(cts.Token);
            _distro = await DistroService.GetByIdAsync(Id, cts.Token);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar distro: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetCategoryName(Guid categoryId) => _categories.FirstOrDefault(c => c.CategoryId == categoryId)?.Name ?? "Sem categoria";
    private string? ResolveImage(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return null;
        }

        if (Uri.TryCreate(imageUrl, UriKind.Absolute, out _))
        {
            return imageUrl;
        }

        return new Uri(new Uri(ApiOptions.Value.BaseUrl), imageUrl).ToString();
    }
}
